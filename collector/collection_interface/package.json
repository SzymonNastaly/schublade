{
	"name": "collection_interface",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.18.1",
	"imports": {
		"#collector_bridge": {
			"stand_in": "./stand_in/stand_in_bridge.ts",
			"default": "./src/tauri_bridge.ts"
		}
	},
	"scripts": {
		"build": "vite build",
		"serve:stand_in": "vite --mode stand_in",
		"application:develop": "TAURI_APP_PATH=../collection_application tauri dev",
		"application:bundle": "TAURI_APP_PATH=../collection_application tauri build",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"check": "tsc --noEmit && eslint . && prettier --check . && vitest run",
		"icons:generate": "node generate_application_icons.ts"
	},
	"dependencies": {
		"@fontsource-variable/source-sans-3": "5.3.1",
		"@phosphor-icons/react": "2.1.10",
		"@tanstack/react-query": "5.106.1",
		"@tauri-apps/api": "2.12.5",
		"@tauri-apps/plugin-dialog": "2.8.4",
		"@tauri-apps/plugin-opener": "2.7.3",
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"devDependencies": {
		"@tailwindcss/vite": "4.3.4",
		"@tanstack/eslint-config": "0.4.0",
		"@tauri-apps/cli": "2.12.5",
		"@types/node": "24.19.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.2.1",
		"eslint": "10.14.0",
		"eslint-plugin-better-tailwindcss": "4.10.0",
		"prettier": "3.9.10",
		"prettier-plugin-tailwindcss": "0.8.1",
		"tailwindcss": "4.3.4",
		"typescript": "6.0.3",
		"vite": "8.3.6",
		"vitest": "5.1.0"
	}
}
