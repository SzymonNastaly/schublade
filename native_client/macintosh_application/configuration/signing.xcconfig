// Ad hoc signing for every configuration, until a Developer ID certificate exists. A Developer ID
// build names its identity in local_signing.xcconfig beside this file, which git ignores:
//     CODE_SIGN_IDENTITY = Developer ID Application
//     DEVELOPMENT_TEAM = <team identifier>
//     OTHER_CODE_SIGN_FLAGS = --timestamp
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
ENABLE_HARDENED_RUNTIME = YES
#include? "local_signing.xcconfig"

// Xcode adds the debugging entitlement get-task-allow to every build but an archive, and the notary
// service refuses an application that requests it.
CODE_SIGN_INJECT_BASE_ENTITLEMENTS[config=Release] = NO
