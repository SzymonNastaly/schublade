{
	"name": "schublade",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.18.1",
	"scripts": {
		"dev": "cf dev",
		"build": "cf build",
		"deploy": "cf deploy",
		"provision": "node scripts/provision_environment.ts",
		"generate:test-documents": "node scripts/generate_test_documents.ts",
		"typecheck": "cf workers types && tsc --noEmit",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"knip": "knip",
		"check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm knip",
		"prepare": "simple-git-hooks"
	},
	"dependencies": {
		"@cloudflare/kumo": "^2.17.0",
		"@tailwindcss/vite": "^4.3.4",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-start": "1.169.4",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwindcss": "^4.3.4",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "2.0.0-beta.v.12",
		"@embedpdf/pdfium": "^2.15.1",
		"@ibm/plex-mono": "^2.5.0",
		"@ibm/plex-sans": "^1.1.0",
		"@ibm/plex-serif": "^2.0.0",
		"@tanstack/eslint-config": "^0.4.0",
		"@types/emscripten": "^1.41.6",
		"@types/node": "^24.10.0",
		"@types/pdfkit": "^0.17.7",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.2.1",
		"cf": "1.0.0-beta.28",
		"eslint": "^10.14.0",
		"jpeg-js": "^0.4.4",
		"knip": "^6.44.1",
		"pdfkit": "^0.20.2",
		"prettier": "^3.9.10",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"simple-git-hooks": "^2.14.0",
		"typescript": "~6.0.3",
		"vite": "^8.3.6"
	},
	"simple-git-hooks": {
		"pre-push": "pnpm check"
	}
}
