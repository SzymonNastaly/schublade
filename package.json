{
	"name": "schublade",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.18.1",
	"scripts": {
		"predev": "pnpm run database:migrate:local",
		"dev": "cf dev",
		"build": "cf build",
		"deploy": "cf deploy",
		"provision": "node scripts/provision_environment.ts",
		"database:generate": "drizzle-kit generate",
		"database:migrate:local": "cf d1 migrations apply 00000000-0000-4000-8000-000000000000 --local --persist-to .cloudflare/state --dir drizzle",
		"generate:test-documents": "node scripts/generate_test_documents.ts",
		"evaluate:extraction": "node scripts/evaluate_extraction.ts",
		"evaluate:search": "node scripts/evaluate_search.ts",
		"typecheck": "cf workers types && tsc --noEmit",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"knip": "knip",
		"check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm knip && pnpm test",
		"prepare": "simple-git-hooks",
		"test": "vitest run"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@cloudflare/workers-oauth-provider": "1.2.4",
		"@embedpdf/pdfium": "^2.15.1",
		"@fontsource-variable/source-sans-3": "^5.3.1",
		"@modelcontextprotocol/server": "2.4.0",
		"@phosphor-icons/react": "^2.1.10",
		"@tailwindcss/vite": "^4.3.4",
		"@tanstack/react-query": "^5.106.1",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-start": "1.169.4",
		"agents": "0.33.0",
		"ai": "^7.0.163",
		"drizzle-orm": "^0.45.4",
		"drizzle-zod": "^0.8.3",
		"fast-png": "^8.0.0",
		"jose": "^6.2.15",
		"pdfjs-dist": "6.5.438",
		"postal-mime": "4.1.4",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwindcss": "^4.3.4",
		"workers-ai-provider": "^4.0.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "2.0.0-beta.v.12",
		"@cloudflare/vitest-plugin": "^1.6.0",
		"@ibm/plex-mono": "^2.5.0",
		"@ibm/plex-sans": "^1.1.0",
		"@ibm/plex-serif": "^2.0.0",
		"@tanstack/eslint-config": "^0.4.0",
		"@types/emscripten": "^1.41.6",
		"@types/node": "^24.10.0",
		"@types/pdfkit": "^0.17.7",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.2.1",
		"cf": "1.0.0-beta.28",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.14.0",
		"eslint-plugin-better-tailwindcss": "^4.10.0",
		"jpeg-js": "^0.4.4",
		"knip": "^6.44.1",
		"pdfkit": "^0.20.2",
		"prettier": "^3.9.10",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"simple-git-hooks": "^2.14.0",
		"typescript": "~6.0.3",
		"vite": "^8.3.6",
		"vitest": "^5.1.0"
	},
	"simple-git-hooks": {
		"pre-push": "pnpm check"
	}
}
